<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
    <AssemblyName>Reefact.LuxaforLightingDeviceController</AssemblyName>
    <RootNamespace>Reefact.LuxaforLightingDeviceController</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Reefact.LuxaforLightingDeviceController</PackageId>
    <Version>2.0.1</Version>
    <Title>Luxafor Lighting Device Controller</Title>
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>
    <Product>Reefact.LuxaforLightingDeviceController</Product>
    <Description>Control Luxafor USB HID devices directly from .NET: colors, fades, strobes and built-in patterns, LED by LED. No Luxafor server, no webhook. Device control is Windows-only.</Description>
    <Copyright>©2026 Reefact</Copyright>
    <PackageTags>luxafor;hid;usb;led;windows;notification;availability;presence</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Reefact/luxafor-lighting-device-controller</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/luxafor-lighting-device-controller.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- An absolute URL: on nuget.org, a bare file name is not something the reader can follow. -->
    <PackageReleaseNotes>See https://github.com/Reefact/luxafor-lighting-device-controller/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Source Link, symbols and reproducible builds -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="hidlibrary" Version="3.3.40" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <!-- Allows the .NET Framework target to be built on any OS (including CI agents without .NET Framework). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The English README is the one shipped in the package, under the name NuGet expects. -->
    <None Include="..\README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Reefact.LuxaforLightingDeviceController.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
